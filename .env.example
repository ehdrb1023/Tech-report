# ============================================================
#  discord-ai-trend-bot  —  환경변수 예시
#  이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
#  .env 는 .gitignore 에 포함되어 있으니 절대 커밋하지 마세요.
# ============================================================

# --- 필수: Discord Webhook ---------------------------------
# Discord 채널 → 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# --- 필수: Anthropic (Claude) API --------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 요약에 사용할 모델 (기본: claude-opus-5)
# 비용을 줄이려면 claude-sonnet-5 로 바꿔도 됩니다.
CLAUDE_MODEL=claude-opus-5

# --- Reddit -------------------------------------------------
# 기본은 인증 없이 공개 RSS 를 씁니다. 키가 없어도 동작합니다.
#
# User-Agent 는 Reddit 규약 형식으로, 본인 계정명을 넣으세요.
#   <platform>:<app id>:<version> (by /u/<username>)
# 익명 UA 보다 차단 위험이 낮습니다.
REDDIT_USER_AGENT=python:discord-ai-trend-bot:v1.0 (by /u/your_reddit_id)

# 선택: 앱 등록이 가능하면 채우세요. 넣으면 자동으로 OAuth+JSON 경로로 바뀌고
# 업보트 수와 페이지네이션이 살아납니다. 비워두면 RSS 를 씁니다.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- 선택: X 공식 API --------------------------------------
# 비워두면 Nitter 미러(무료, 가용성 보장 안 됨)를 씁니다.
# 토큰을 넣으면 코드 수정 없이 공식 API(user timeline)로 전환됩니다.
# https://developer.x.com — 종량제이며 읽기 1건당 과금되므로 요금을 먼저 확인하세요.
X_BEARER_TOKEN=

# --- 선택: 동작 튜닝 ---------------------------------------
# 리포트 대상 기간(시간). 기본 24
LOOKBACK_HOURS=24
# Claude 에게 보낼 최대 아이템 수. 비워두면 무제한(문턱 통과분 전부).
# config.yaml 의 collect.min_keyword_score 가 실질적인 관문입니다.
# MAX_ITEMS=
# 리포트 언어 (ko / en)
REPORT_LANGUAGE=ko
# 리포트 기준 타임존
TIMEZONE=Asia/Seoul
